{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thinks-inscription",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "account_id": "79da5f54f2a80db02b37cf77990c015c",
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "APP_ORIGIN": "https://thinks-inscription.thinks-tagswin.workers.dev",
    "DISCORD_CLIENT_ID": "1560673055494111272",
    "DISCORD_GUILD_ID": "1498690479288483932",
    "DISCORD_MEMBER_ROLE_ID": "1522516492904693831"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thinks-inscription",
      "database_id": "2bf3f8a4-ab87-4e3a-9e9e-559584676ea0",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["30 3 * * *"] }
}
